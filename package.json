{
  "name": "cow-clone",
  "version": "0.1.1",
  "description": "Copy-on-write clones of files and whole directory trees on APFS, btrfs, XFS, bcachefs and ReFS, with a reason when a clone is not possible",
  "type": "module",
  "engines": {
    "node": "^20.19.4 || >=22.12.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "bin": {
    "cow-clone": "bin/cow-clone",
    "cow-clone-windows": "prebuilds/win32-x64/cow-clone.exe"
  },
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "import": "./index.mjs"
    }
  },
  "files": [
    "bin",
    "index.mjs",
    "index.d.mts",
    "prebuilds",
    "skill",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "clone",
    "clonefile",
    "copy-on-write",
    "reflink",
    "ficlone",
    "apfs",
    "btrfs",
    "xfs",
    "refs",
    "block-cloning"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appandflow/cow-clone.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-concurrency=1 test/cli.test.mjs test/api.test.mjs test/tree.test.mjs test/darwin.test.mjs test/linux.test.mjs test/windows.test.mjs test/launcher.test.mjs test/package.test.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "pack:release": "node scripts/pack-release.mjs",
    "bench": "node scripts/bench.mjs",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  }
}
